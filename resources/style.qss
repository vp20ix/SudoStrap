    border-color: #c07830;
}

/* ---- Toggle switches ---- */
#unlockFpsCheck, #shadowsCheck, #postFxCheck, #grassCheck,
#aaCheck, #bloomCheck, #skyGrayCheck {
    spacing: 0px;
    padding: 0px;
    margin: 0px;
    background-color: transparent;
    border: none;
    min-width: 50px; max-width: 50px;
    min-height: 30px; max-height: 30px;
    color: transparent;
}

#unlockFpsCheck::indicator, #shadowsCheck::indicator,
#postFxCheck::indicator, #grassCheck::indicator,
#aaCheck::indicator, #bloomCheck::indicator,
#skyGrayCheck::indicator {
    width: 50px;
    height: 30px;
    border: none;
    background: transparent;
    image: url(/home/vp20/SudoStrap/resources/icons/toggle_off.svg);
}

#unlockFpsCheck::indicator:checked, #shadowsCheck::indicator:checked,
#postFxCheck::indicator:checked, #grassCheck::indicator:checked,
#aaCheck::indicator:checked, #bloomCheck::indicator:checked,
#skyGrayCheck::indicator:checked {
    image: url(/home/vp20/SudoStrap/resources/icons/toggle_on.svg);
}

#launchButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #22d3ee, stop:1 #0078d4);
    color: #ffffff;
    border: none;
    padding: 15px 20px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 10px;
    margin: 0px 16px;
    min-height: 22px;
}
#launchButton:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #40dcf0, stop:1 #1084d8); }
#launchButton:pressed { background: #005a9e; }

#ffCustomButton {
    background-color: #22d3ee;
    color: #0a0a12;
    border: none;
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 700;
    border-radius: 8px;
    min-width: 180px;
}
#ffCustomButton:hover { background-color: #40dcf0; }
#ffCustomButton:pressed { background-color: #0078d4; color: #ffffff; }

#saveButton {
    background-color: #14222e;
    color: #22d3ee;
    border: 1px solid #1e3a4e;
    padding: 7px 16px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 700;
    min-width: 76px;
}
#saveButton:enabled:hover { background-color: #0078d4; color: #ffffff; border-color: #0078d4; }
#saveButton:disabled { background-color: #14141c; color: #4a4a5e; border-color: #1a1a26; }

/* ============ Launch Button — Deep Blue ============ */
#launchButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0078d4, stop:1 #0058a0);
    color: #ffffff;
    border: none;
    padding: 15px 20px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 10px;
    margin: 0px 16px;
    min-height: 22px;
}
#launchButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1084d8, stop:1 #0068b8);
}
#launchButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #005a9e, stop:1 #004080);
}

/* ============ ABOUT PAGE ============ */
#abtHero, #abtLinks, #abtCredits {
    background-color: #16161f;
    border: 1px solid #1e1e2e;
    border-radius: 12px;
}
#abtHero:hover, #abtLinks:hover, #abtCredits:hover {
    background-color: #1a1a26;
    border: 1px solid #2f2f44;
}

#abtLogo {
    font-size: 56px;
    background-color: #1e1e2e;
    border: 1px solid #22d3ee;
    border-radius: 16px;
    min-width: 96px; max-width: 96px;
    min-height: 96px; max-height: 96px;
}

#abtHeroTitle {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    background: transparent;
}

#abtHeroVersion {
    font-size: 12px;
    font-weight: 600;
    color: #22d3ee;
    background: transparent;
}

#abtHeroDesc {
    font-size: 13px;
    color: #7a7a8e;
    background: transparent;
}

#abtLinksTitle, #abtCreditsTitle {
    font-size: 11px;
    font-weight: 700;
    color: #4a4a5e;
    letter-spacing: 2.5px;
    background: transparent;
}

#abtCreditsText {
    font-size: 13px;
    color: #7a7a8e;
    background: transparent;
    line-height: 1.5;
}

#btnGithub, #btnDocs, #btnIssue {
    background-color: #1a1a26;
    color: #e8e8ee;
    border: 1px solid #2a2a3e;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
    border-radius: 8px;
}

#btnGithub:hover, #btnDocs:hover, #btnIssue:hover {
    background-color: #22d3ee;
    color: #0a0a12;
    border-color: #22d3ee;
}

#btnGithub:pressed, #btnDocs:pressed, #btnIssue:pressed {
    background-color: #0078d4;
    color: #ffffff;
    border-color: #0078d4;
}

