    color: #7a7a8e;
    background: transparent;
}

/* ---- Eyebrows ---- */
#perfEyebrow, #gfxEyebrow, #ffEyebrow, #setEyebrow, #abtEyebrow {
    font-size: 11px;
    font-weight: 700;
    color: #22d3ee;
    letter-spacing: 3px;
    background: transparent;
    padding-bottom: 8px;
}

/* ---- Page Titles ---- */
#perfTitle, #gfxTitle, #ffTitle, #setTitle, #abtTitle {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    background: transparent;
    letter-spacing: -0.5px;
    padding-bottom: 6px;
}

/* ---- Page Subtitles ---- */
#perfSubtitle, #gfxSubtitle, #ffSubtitle, #setSubtitle, #abtSubtitle {
    font-size: 13px;
    color: #7a7a8e;
    background: transparent;
}

/* ---- Nav Section ---- */
#navSectionLabel {
    font-size: 11px;
