/* ============ Ping Boost Card ============ */
#row6 {
    background-color: #16161f;
    border: 1px solid #1e1e2e;
    border-radius: 12px;
}
#row6:hover {
    background-color: #1a1a26;
    border: 1px solid #2f2f44;
}
#icon6 {
    font-size: 22px;
    background-color: #1e1e2e;
    border: 1px solid #1e1e2e;
    border-radius: 12px;
    min-width: 52px; max-width: 52px;
    min-height: 52px; max-height: 52px;
}
#t6 {
    font-size: 15px;
    font-weight: 600;
    color: #e8e8ee;
    background: transparent;
}
#d6 {
    font-size: 12.5px;
    color: #7a7a8e;
    background: transparent;
}

/* ============ Active Preset ============ */
#presetCardPerf[active="true"],
#presetCardBal[active="true"],
#presetCardQual[active="true"] {
    background-color: #14222e;
    border: 1px solid #22d3ee;
}

#presetPerfApply[active="true"],
#presetBalApply[active="true"],
#presetQualApply[active="true"] {
    background-color: #0f2a30;
    color: #22d3ee;
    border: 1px solid #1e3a44;
}

/* Restore Button */
#restoreButton {
    background-color: #14222e;
    color: #7cc4d4;
    border: 1px solid #1e3a44;
    padding: 7px 16px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 700;
    min-width: 76px;
}
#restoreButton:hover {
    background-color: #1a3a4e;
    color: #22d3ee;
    border-color: #22d3ee;
}

/* Export / Import Buttons */
#exportButton, #importButton {
    background-color: #1a1a26;
    color: #a0a0b0;
    border: 1px solid #2a2a3e;
    padding: 7px 16px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 700;
    min-width: 76px;
}
#exportButton:hover, #importButton:hover {
    background-color: #2a2a3e;
    color: #ffffff;
    border-color: #3a3a4e;
}
