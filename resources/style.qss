* { outline: none; }
QMainWindow { background-color: #0a0a12; }
QWidget { color: #e8e8ee; font-family: 'Inter','Segoe UI','Ubuntu',sans-serif; font-size: 13px; }
#sidebar { background-color: #111119; border-right: 1px solid #1e1e2e; }
#appTitle { font-size: 17px; font-weight: 700; color: #ffffff; padding: 26px 24px; background-color: #111119; border-bottom: 1px solid #1e1e2e; }
#sidebar QPushButton { background-color: transparent; border: none; color: #7a7a8e; text-align: left; padding: 10px 18px; font-size: 13.5px; font-weight: 500; border-radius: 8px; margin: 2px 12px; border-left: 3px solid transparent; }
#sidebar QPushButton:hover { background-color: #1c1c28; color: #e8e8ee; }
#sidebar QPushButton:checked { background-color: #1a3a4e; color: #22d3ee; font-weight: 600; border-left: 3px solid #22d3ee; }
#contentArea, QStackedWidget > QWidget { background-color: #0a0a12; }
QScrollArea { background-color: transparent; border: none; }
QScrollArea > QWidget > QWidget { background-color: transparent; }
QScrollBar:vertical { background-color: transparent; width: 10px; margin: 4px 2px; border: none; }
QScrollBar::handle:vertical { background-color: #2a2a3a; min-height: 40px; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background-color: #3a3a4a; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical, QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; height: 0px; }
#navSectionLabel { font-size: 11px; font-weight: 700; color: #4a4a5e; letter-spacing: 2.5px; padding: 22px 24px 10px 24px; background: transparent; }
#statusChip { background-color: #16202a; color: #22d3ee; padding: 8px 14px; border-radius: 8px; font-size: 12.5px; font-weight: 600; margin: 0px 16px 12px 16px; border: 1px solid #1e3a4e; }
#perfEyebrow, #gfxEyebrow, #ffEyebrow, #setEyebrow, #abtEyebrow { font-size: 11px; font-weight: 700; color: #22d3ee; letter-spacing: 3px; background: transparent; padding-bottom: 8px; }
#perfTitle, #gfxTitle, #ffTitle, #setTitle, #abtTitle { font-size: 32px; font-weight: 700; color: #ffffff; background: transparent; letter-spacing: -0.5px; padding-bottom: 6px; }
#perfSubtitle, #gfxSubtitle, #ffSubtitle, #setSubtitle, #abtSubtitle { font-size: 13px; color: #7a7a8e; background: transparent; }
#row1, #row2, #row3, #row4, #row5, #grow1, #grow2, #grow3, #grow4, #grow5, #grow6, #ffrow1, #ffrow2, #ffrow3 { background-color: #16161f; border: 1px solid #1e1e2e; border-radius: 12px; }
#row1, #row2, #row3, #row4, #row5, #grow1, #grow2, #grow3, #grow4, #grow5, #grow6, #ffrow1, #ffrow2, #ffrow3:hover { background-color: #1a1a26; border: 1px solid #2f2f44; }
#ffCtaFrame { background-color: #14222e; border: 1px solid #1e3a4e; border-radius: 12px; }
#icon1, #icon2, #icon3, #icon4, #icon5, #gicon1, #gicon2, #gicon3, #gicon4, #gicon5, #gicon6, #fficon1, #fficon2, #fficon3 { font-size: 22px; background-color: #1e1e2e; border: 1px solid #1e1e2e; border-radius: 12px; min-width: 52px; max-width: 52px; min-height: 52px; max-height: 52px; }
#t1, #t2, #t3, #t4, #t5, #gt1, #gt2, #gt3, #gt4, #gt5, #gt6, #fft1, #fft2, #fft3, #ffCtaTitle { font-size: 15px; font-weight: 600; color: #e8e8ee; background: transparent; }
#d1, #d2, #d3, #d4, #d5, #gd1, #gd2, #gd3, #gd4, #gd5, #gd6, #ffd1, #ffd2, #ffd3, #ffCtaDesc { font-size: 12.5px; color: #7a7a8e; background: transparent; }
#versionLabel { color: #7a7a8e; font-size: 12px; font-weight: 500; background: transparent; }
#saveButton { background-color: #14222e; color: #22d3ee; border: 1px solid #1e3a4e; padding: 7px 16px; border-radius: 7px; font-size: 12px; font-weight: 700; min-width: 76px; }
#saveButton:hover { background-color: #0078d4; color: #ffffff; border-color: #0078d4; }
#closeButton { background-color: #2a1616; color: #ff8080; border: 1px solid #2a1616; padding: 7px 16px; border-radius: 7px; font-size: 12px; font-weight: 700; min-width: 76px; }
#closeButton:hover { background-color: #c0392b; color: #ffffff; border-color: #c0392b; }
#backupButton { background-color: #1a1a26; color: #a0a0b0; border: 1px solid #1a1a26; padding: 7px 16px; border-radius: 7px; font-size: 12px; font-weight: 700; min-width: 76px; }
#backupButton:hover { background-color: #242434; color: #e8e8ee; border-color: #2a2a3e; }
#resetButton { background-color: #241a10; color: #f0a050; border: 1px solid #241a10; padding: 7px 16px; border-radius: 7px; font-size: 12px; font-weight: 700; min-width: 76px; }
#resetButton:hover { background-color: #c07830; color: #ffffff; border-color: #c07830; }
#unlockFpsCheck, #shadowsCheck, #postFxCheck, #grassCheck, #aaCheck, #bloomCheck, #skyGrayCheck { spacing: 0px; padding: 0px; margin: 0px; background: transparent; border: none; min-width: 50px; max-width: 50px; min-height: 30px; max-height: 30px; color: transparent; }
#unlockFpsCheck, #shadowsCheck, #postFxCheck, #grassCheck, #aaCheck, #bloomCheck, #skyGrayCheck::indicator { width: 50px; height: 30px; margin: 0px; padding: 0px; border: none; background: transparent; image: url(/home/vp20/SudoStrap/resources/icons/toggle_off.svg); }
#unlockFpsCheck, #shadowsCheck, #postFxCheck, #grassCheck, #aaCheck, #bloomCheck, #skyGrayCheck::indicator:checked { image: url(/home/vp20/SudoStrap/resources/icons/toggle_on.svg); }

#footer { background-color: #08080f; border-top: 1px solid #1e1e2e; }
#progressBar { background-color: #1a1a26; border: none; border-radius: 3px; }
#progressBar::chunk { background-color: #22d3ee; border-radius: 3px; }
QDialog, QMessageBox { background-color: #111119; }
QMessageBox QLabel { color: #e8e8ee; font-size: 13px; }
QMessageBox QPushButton { background-color: #1a1a26; color: #e8e8ee; border: 1px solid #2a2a3e; padding: 9px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; min-width: 80px; }
QMessageBox QPushButton:hover { background-color: #22d3ee; color: #0a0a12; border-color: #22d3ee; }
QMessageBox QPushButton:default { background-color: #22d3ee; color: #0a0a12; border: none; }
::selection { background-color: #22d3ee; color: #0a0a12; }

/* ============ FIX: SpinBox Arrows ============ */
/* ============ FIX: Custom FastFlags Button ============ */
/* ============ FIX: Launch Button (bigger, better) ============ */

/* ============================================================
   FIXES — Using #objectName (Qt-compatible)
   ============================================================ */

/* ---- Custom FastFlags Button ---- */
#ffCustomButton {
    background-color: #22d3ee;
    color: #0a0a12;
    border: none;
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 700;
    border-radius: 8px;
    min-width: 180px;
}
#ffCustomButton:hover { background-color: #40dcf0; }
#ffCustomButton:pressed { background-color: #0078d4; }

/* ---- Launch Button ---- */
#launchButton {
    background-color: #22d3ee;
    color: #ffffff;
    border: none;
    padding: 15px 20px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 10px;
    margin: 0px 16px;
    min-height: 22px;
}
#launchButton:hover { background-color: #40dcf0; }
#launchButton:pressed { background-color: #0078d4; }

/* ---- SpinBox (clean, no ugly arrows) ---- */
QSpinBox {
    background-color: #1a1a26;
    border: 1px solid #2a2a3e;
    border-radius: 8px;
    padding: 8px 14px;
    padding-right: 28px;
    color: #e8e8ee;
    font-size: 13px;
    font-weight: 600;
    min-width: 110px;
}
QSpinBox:hover { border-color: #3d3d58; background-color: #1f1f2d; }
QSpinBox:focus { border-color: #22d3ee; }

QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    background-color: transparent;
    border: none;
    width: 20px;
    height: 12px;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    margin: 3px 4px 0px 0px;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    margin: 0px 4px 3px 0px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #2a2a3e;
    border-radius: 3px;
}

QSpinBox::up-arrow {
    image: url(/home/vp20/SudoStrap/resources/icons/arrow_up.svg);
    width: 8px;
    height: 5px;
}

QSpinBox::down-arrow {
    image: url(/home/vp20/SudoStrap/resources/icons/arrow_down.svg);
    width: 8px;
    height: 5px;
}

QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off {
    image: url(/home/vp20/SudoStrap/resources/icons/arrow_up.svg);
    opacity: 0.3;
}
QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off {
    image: url(/home/vp20/SudoStrap/resources/icons/arrow_down.svg);
    opacity: 0.3;
}

/* ---- Row Cards (using object names) ---- */
#row1, #row2, #row3, #row4, #row5,
#grow1, #grow2, #grow3, #grow4, #grow5, #grow6,
#ffrow1, #ffrow2, #ffrow3 {
    background-color: #16161f;
    border: 1px solid #1e1e2e;
    border-radius: 12px;
}

#row1:hover, #row2:hover, #row3:hover, #row4:hover, #row5:hover,
#grow1:hover, #grow2:hover, #grow3:hover, #grow4:hover, #grow5:hover, #grow6:hover,
#ffrow1:hover, #ffrow2:hover, #ffrow3:hover {
    background-color: #1a1a26;
    border: 1px solid #2f2f44;
}

#ffCtaFrame {
    background-color: #14222e;
    border: 1px solid #1e3a4e;
    border-radius: 12px;
}

/* ---- Icon containers ---- */
#icon1, #icon2, #icon3, #icon4, #icon5,
#gicon1, #gicon2, #gicon3, #gicon4, #gicon5, #gicon6,
#fficon1, #fficon2, #fficon3 {
    font-size: 22px;
    background-color: #1e1e2e;
    border: 1px solid #1e1e2e;
    border-radius: 12px;
    min-width: 52px; max-width: 52px;
    min-height: 52px; max-height: 52px;
}

/* ---- Row Titles ---- */
#t1, #t2, #t3, #t4, #t5,
#gt1, #gt2, #gt3, #gt4, #gt5, #gt6,
#fft1, #fft2, #fft3, #ffCtaTitle {
    font-size: 15px;
    font-weight: 600;
    color: #e8e8ee;
    background: transparent;
}

/* ---- Row Descriptions ---- */
#d1, #d2, #d3, #d4, #d5,
#gd1, #gd2, #gd3, #gd4, #gd5, #gd6,
#ffd1, #ffd2, #ffd3, #ffCtaDesc {
