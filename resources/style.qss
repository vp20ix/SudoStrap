/* ============ COMBO BOX ============ */
QComboBox {
    background-color: #1a1a26;
    border: 1px solid #2a2a3e;
    border-radius: 8px;
    padding: 8px 34px 8px 14px;
    color: #e8e8ee;
    font-size: 13px;
    font-weight: 500;
    min-width: 140px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #3d3d58;
    background-color: #1f1f2d;
}

QComboBox:focus, QComboBox:on {
    border: 1px solid #22d3ee;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(/home/vp20/SudoStrap/resources/icons/chevron_down.svg);
    width: 14px;
    height: 9px;
    margin-right: 10px;
}

/* Dropdown list — absolutely no border */
QComboBox QAbstractItemView {
    background-color: #1a1a26;
    border: none;
    padding: 5px;
    color: #e8e8ee;
    outline: 0;
    selection-background-color: transparent;
}

QComboBox QAbstractItemView::item {
    background-color: transparent;
    color: #e8e8ee;
    padding: 8px 14px;
    border: none;
    border-radius: 6px;
    min-height: 22px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2a2a3e;
    color: #ffffff;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #22d3ee;
    color: #0a0a12;
}

/* ============ Input Dialog (Paste JSON etc) ============ */
QInputDialog {
    background-color: #111119;
}

QInputDialog QLabel {
    color: #e8e8ee;
    font-size: 13px;
    background: transparent;
}

QInputDialog QTextEdit,
QInputDialog QPlainTextEdit,
QInputDialog QLineEdit {
    background-color: #1a1a26;
    border: 1px solid #2a2a3e;
    border-radius: 8px;
    padding: 10px 14px;
    color: #e8e8ee;
    font-size: 13px;
    font-family: 'JetBrains Mono', 'Cascadia Code', 'Consolas', monospace;
    selection-background-color: #22d3ee;
    selection-color: #0a0a12;
}

QInputDialog QTextEdit:focus,
QInputDialog QPlainTextEdit:focus,
QInputDialog QLineEdit:focus {
    border: 1px solid #22d3ee;
}

QInputDialog QPushButton {
    background-color: #1a1a26;
    color: #e8e8ee;
    border: 1px solid #2a2a3e;
    padding: 8px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    min-width: 80px;
}

QInputDialog QPushButton:hover {
    background-color: #0078d4;
    color: #ffffff;
    border-color: #0078d4;
}

QInputDialog QPushButton:default {
    background-color: #22d3ee;
    color: #0a0a12;
    border: none;
}

QInputDialog QPushButton:default:hover {
    background-color: #40dcf0;
}

/* ============ PRESETS ============ */
#ffSectionPresets {
    font-size: 11px;
    font-weight: 700;
    color: #4a4a5e;
    letter-spacing: 2.5px;
    padding: 18px 4px 6px 4px;
    background: transparent;
}

#presetsToggleRow {
    background-color: #16161f;
    border: 1px solid #1e1e2e;
    border-radius: 12px;
}
#presetsToggleRow:hover {
    background-color: #1a1a26;
    border: 1px solid #2f2f44;
}

#presetsToggleIcon {
    font-size: 22px;
    background-color: #1e1e2e;
    border: 1px solid #1e1e2e;
    border-radius: 12px;
    min-width: 52px; max-width: 52px;
    min-height: 52px; max-height: 52px;
}

#presetsToggleTitle {
    font-size: 15px;
    font-weight: 600;
    color: #e8e8ee;
    background: transparent;
}

#presetsToggleDesc {
    font-size: 12.5px;
    color: #7a7a8e;
    background: transparent;
}

#presetCardPerf, #presetCardBal, #presetCardQual {
    background-color: #16161f;
    border: 1px solid #1e1e2e;
    border-radius: 12px;
}
#presetCardPerf:hover, #presetCardBal:hover, #presetCardQual:hover {
    background-color: #1a1a26;
    border: 1px solid #2f2f44;
}

#presetPerfIcon, #presetBalIcon, #presetQualIcon {
    font-size: 22px;
    background-color: #1e1e2e;
    border: 1px solid #1e1e2e;
    border-radius: 12px;
    min-width: 52px; max-width: 52px;
    min-height: 52px; max-height: 52px;
}

#presetPerfTitle, #presetBalTitle, #presetQualTitle {
    font-size: 15px;
    font-weight: 600;
    color: #e8e8ee;
    background: transparent;
}

#presetPerfDesc, #presetBalDesc, #presetQualDesc {
    font-size: 12.5px;
    color: #7a7a8e;
    background: transparent;
}

#presetPerfApply, #presetBalApply, #presetQualApply {
    background-color: #22d3ee;
    color: #0a0a12;
    border: none;
    padding: 8px 18px;
    font-size: 12px;
    font-weight: 700;
    border-radius: 8px;
    min-width: 80px;
}
#presetPerfApply:hover, #presetBalApply:hover, #presetQualApply:hover {
    background-color: #40dcf0;
}

#presetPerfDetails, #presetBalDetails, #presetQualDetails {
    background-color: #1a1a26;
    color: #a0a0b0;
    border: 1px solid #2a2a3e;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 8px;
    min-width: 70px;
}
#presetPerfDetails:hover, #presetBalDetails:hover, #presetQualDetails:hover {
    background-color: #2a2a3e;
    color: #ffffff;
    border-color: #3a3a4e;
}

